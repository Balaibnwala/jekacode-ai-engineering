# Copy this file and rename it to .env
# Never share your keys. Never upload .env to GitHub.

# Free Gemini key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=paste_your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# Grok (xAI) — https://console.x.ai
GROK_API_KEY=paste_your_grok_key_here
GROK_MODEL=grok-3-mini

# DeepSeek key from DeepSeek Platform:
# https://platform.deepseek.com
DEEPSEEK_API_KEY=paste_your_deepseek_key_here

# Optional: Hugging Face (model hub + inference)
# https://huggingface.co/settings/tokens
HF_TOKEN=paste_your_hf_token_here
HF_MODEL=HuggingFaceH4/zephyr-7b-beta

# Local Ollama (no key). After: ollama run llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434/api/chat
